{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@common/types/*": [
        "../_common/types/*"
      ],
      "@common/stores/*": [
        "../_common/stores/*"
      ],
      "@common/hooks": [
        "../_common/hooks/index.ts"
      ],
      "@common/hooks/*": [
        "../_common/hooks/*"
      ],
      "@common/services": [
        "../_common/services/index.ts"
      ],
      "@common/services/*": [
        "../_common/services/*"
      ],
      "@common/utils/*": [
        "../_common/utils/*"
      ],
      "@common/schemas/*": [
        "../_common/schemas/*"
      ],
      "@/*": [
        "./*"
      ]
    },
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../_common/types/**/*.d.ts",
    "../_common/schemas/**/*.ts",
    "../_common/themes/calm-theme.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.stories.tsx"
  ]
}
