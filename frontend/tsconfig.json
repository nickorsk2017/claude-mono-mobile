{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@common/types/*": ["./_common/types/*"],
      "@common/stores/*": ["./_common/stores/*"],
      "@common/hooks": ["./_common/hooks/index.ts"],
      "@common/hooks/*": ["./_common/hooks/*"],
      "@common/ui-kit/*": ["./_common/ui-kit/src/*"],
      "@common/services": ["./_common/services/index.ts"],
      "@common/services/*": ["./_common/services/*"],
      "@common/utils/*": ["./_common/utils/*"]
    }
  },
  "references": [
    { "path": "./web" },
    { "path": "./mobile" }
  ]
}
