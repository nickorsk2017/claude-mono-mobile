{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "@common/types/*": ["../_common/types/*"],
      "@common/stores/*": ["../_common/stores/*"],
      "@common/hooks": ["../_common/hooks/index.ts"],
      "@common/hooks/*": ["../_common/hooks/*"],
      "@common/ui-kit": ["../_common/ui-kit/src/index.ts"],
      "@common/ui-kit/*": ["../_common/ui-kit/src/*"],
      "@common/services": ["../_common/services/index.ts"],
      "@common/services/*": ["../_common/services/*"],
      "@common/utils/*": ["../_common/utils/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../_common/types/*.d.ts"],
  "exclude": ["node_modules"]
}
