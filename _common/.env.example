# ─── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# ─── Web (Next.js) ─────────────────────────────────────────────────────────────
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
BACKEND_URL=http://api:4000

# ─── Mobile (Expo / React Native) ─────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ─── API ───────────────────────────────────────────────────────────────────────
GATEWAY_PORT=4000
GATEWAY_CORS_ORIGIN=http://localhost:3000

# ─── MCP Agent ─────────────────────────────────────────────────────────────────
MCP_PORT=5000
MCP_ANTHROPIC_API_KEY=your-anthropic-api-key
MCP_MODEL_ID=claude-sonnet-4-6
MCP_BACKEND_URL=http://api:4000
