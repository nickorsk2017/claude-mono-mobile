# ─── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# ─── Web (Next.js) ─────────────────────────────────────────────────────────────
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# ─── Backend (NestJS) ──────────────────────────────────────────────────────────
BACKEND_PORT=4000
BACKEND_JWT_SECRET=change-this-to-a-long-random-secret
BACKEND_JWT_EXPIRATION_SECONDS=3600
BACKEND_CORS_ORIGIN=http://localhost:3000

# ─── MCP Agent ─────────────────────────────────────────────────────────────────
MCP_PORT=5000
MCP_ANTHROPIC_API_KEY=your-anthropic-api-key
MCP_MODEL_ID=claude-sonnet-4-6
MCP_BACKEND_URL=http://backend:4000
