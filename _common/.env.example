# ─── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# ─── Web (Next.js) ─────────────────────────────────────────────────────────────
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# ─── API Gateway ───────────────────────────────────────────────────────────────
GATEWAY_PORT=4000
GATEWAY_CORS_ORIGIN=http://localhost:3000

# ─── Auth Service (internal) ───────────────────────────────────────────────────
AUTH_SERVICE_PORT=4001
AUTH_SERVICE_URL=http://auth-service:4001

# ─── User Service (internal) ───────────────────────────────────────────────────
USER_SERVICE_PORT=4002
USER_SERVICE_URL=http://user-service:4002

# ─── MCP Agent ─────────────────────────────────────────────────────────────────
MCP_PORT=5000
MCP_ANTHROPIC_API_KEY=your-anthropic-api-key
MCP_MODEL_ID=claude-sonnet-4-6
MCP_BACKEND_URL=http://gateway:4000
